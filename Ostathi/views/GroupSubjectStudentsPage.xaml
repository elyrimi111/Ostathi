<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ostathi.GroupSubjectStudentsPage"
             x:Name="RootPage"
             Title="إدارة طلاب المجموعة"
             FlowDirection="RightToLeft"
             BackgroundColor="{StaticResource DarkBackground}">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="16" RowSpacing="12">

        <!-- Header Card -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource DarkSurface}"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0"
                Padding="16">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                    <Label Text="إدارة طلاب المجموعة"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>

                    <Label Text="{Binding GroupName, StringFormat='المجموعة: {0}'}"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"/>

                    <Label Text="{Binding SubjectName, StringFormat='المادة: {0}'}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AccentYellow}"/>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource DarkInputBackground}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="12,6"
                        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                        <Label Text="{Binding TotalStudentsCount}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource AccentYellow}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="طالب"
                               FontSize="10"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource DarkSurface}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0"
                Padding="10,2">
            <SearchBar Placeholder="ابحث باسم الطالب أو الرقم الأكاديمي..."
                       Text="{Binding SearchQuery}"
                       TextColor="{StaticResource TextPrimary}"
                       PlaceholderColor="{StaticResource TextSecondary}"
                       BackgroundColor="Transparent"/>
        </Border>

        <!-- Section Title -->
        <Label Grid.Row="2"
               Text="قائمة طلاب المجموعة:"
               FontSize="12"
               FontAttributes="Bold"
               TextColor="{StaticResource TextSecondary}"
               Margin="2,0"/>

        <!-- Students Collection -->
        <Grid Grid.Row="3">

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource AccentYellow}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="8"
                                 Padding="20">
                <Label Text="لا يوجد طلاب مسجلون في هذه المجموعة حالياً"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"/>

                <Label Text="تظهر هنا قائمة الطلاب المرتبطين بهذه المجموعة"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         IsVisible="{Binding IsNotBusy}">
                <CollectionView ItemsSource="{Binding FilteredStudents}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource DarkSurface}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    Padding="12">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenStudentDetailsCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">

                                    <Border Grid.Column="0"
                                            BackgroundColor="{StaticResource DarkInputBackground}"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            WidthRequest="42"
                                            HeightRequest="42"
                                            VerticalOptions="Center">
                                        <Label Text="🎓"
                                               FontSize="20"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding FullName}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>

                                        <Label Text="{Binding AcademicId, StringFormat='الرقم الأكاديمي: {0}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource AccentYellow}"/>

                                        <Label Text="{Binding AcademicYear}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}"/>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="2"
                                            Text="⋮"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            BackgroundColor="{StaticResource DarkInputBackground}"
                                            TextColor="{StaticResource TextPrimary}"
                                            CornerRadius="8"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            Padding="0"
                                            VerticalOptions="Center"
                                            Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.StudentOptionsCommand}"
                                            CommandParameter="{Binding .}"/>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
