<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ostathi"
             x:Class="Ostathi.ExportMasterPage"
             Title="التصدير الشامل"
             BackgroundColor="{StaticResource DarkBackground}"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, *">

        <!-- 1. رأس الصفحة (Header) -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="20,16"
              VerticalOptions="Center"
              BackgroundColor="{StaticResource DarkBackground}">

            <Button Grid.Column="0"
                    Text="✕"
                    FontSize="16"
                    TextColor="{StaticResource TextPrimary}"
                    BackgroundColor="{StaticResource DarkSurface}"
                    CornerRadius="18"
                    WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center"
                    Command="{Binding ClosePageCommand}"/>

            <Label Grid.Column="1"
                   Text="تصدير التقارير"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource AccentYellow}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <BoxView Grid.Column="2" WidthRequest="36" BackgroundColor="Transparent"/>
        </Grid>

        <!-- 2. المحتوى الرئيسي -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- المجموعة المستهدفة -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="المجموعة المستهدفة للتصدير" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    <local:GroupCard BindingContext="{Binding CurrentGroup}" />
                </VerticalStackLayout>

                <!-- خيارات التصدير (اكسل و PDF فقط) -->
                <VerticalStackLayout Spacing="14">
                    <Label Text="اختر صيغة التصدير" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />

                    <!-- خيار 1: تصدير إكسل (Excel) -->
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="16">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="تصدير السجل الشامل (Excel)" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="ملف Excel يضم كافة درجات وسجلات المجموعة بالكامل" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="تصدير" 
                                    Command="{Binding ExportMasterExcelCommand}"
                                    BackgroundColor="{StaticResource AccentYellow}" 
                                    TextColor="{StaticResource DarkBackground}" 
                                    FontAttributes="Bold" FontSize="11" CornerRadius="10" HeightRequest="36" Padding="16,0"/>
                        </Grid>
                    </Border>

                    <!-- خيار 2: تصدير PDF -->
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="16">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="تصدير التقرير (PDF)" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="تصدير كشف الحضور والتقارير بملف PDF" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="تصدير" 
                                    Command="{Binding ExportPdfCommand}"
                                    BackgroundColor="{StaticResource DarkBackground}" 
                                    TextColor="{StaticResource TextPrimary}" 
                                    FontAttributes="Bold" FontSize="11" CornerRadius="10" HeightRequest="36" Padding="16,0"/>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
