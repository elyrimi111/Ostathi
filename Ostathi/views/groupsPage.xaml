<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ostathi.ViewModels"
             x:Class="Ostathi.groupsPage"
             BackgroundColor="{StaticResource DarkBackground}"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, *">

        <!-- 1. الأشرطة الثلاثة في الأعلى مباشرة -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,12,0,0" IsVisible="{Binding HasGroups}">
            
            <!-- أ. شريط المواد -->
            <CollectionView ItemsSource="{Binding SubjectsList}" 
                            SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                            SelectionMode="Single"
                            HeightRequest="38"
                            Margin="20,0,0,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 14" Padding="14,6" StrokeThickness="1">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource DarkSurface}" />
                                            <Setter Property="Stroke" Value="{StaticResource DarkSurface}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource AccentYellow}" />
                                            <Setter Property="Stroke" Value="{StaticResource AccentYellow}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ب. شريط التخصصات -->
            <CollectionView ItemsSource="{Binding SpecializationsList}" 
                            SelectedItem="{Binding SelectedSpecialization, Mode=TwoWay}"
                            SelectionMode="Single"
                            HeightRequest="38"
                            Margin="20,0,0,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 14" Padding="14,6" StrokeThickness="1">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource DarkSurface}" />
                                            <Setter Property="Stroke" Value="{StaticResource DarkSurface}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource AccentYellow}" />
                                            <Setter Property="Stroke" Value="{StaticResource AccentYellow}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ج. شريط السنوات الدراسية -->
            <CollectionView ItemsSource="{Binding YearsList}" 
                            SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                            SelectionMode="Single"
                            HeightRequest="38"
                            Margin="20,0,0,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 14" Padding="14,6" StrokeThickness="1">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource DarkSurface}" />
                                            <Setter Property="Stroke" Value="{StaticResource DarkSurface}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource AccentYellow}" />
                                            <Setter Property="Stroke" Value="{StaticResource AccentYellow}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

        <!-- 2. لوحة التحكم الديناميكية في الأسفل -->
        <ContentView Grid.Row="1" x:Name="DashboardContainer"
                     Content="{Binding DynamicDashboardContent}" 
                     IsVisible="{Binding HasGroups}"
                     Margin="0,8,0,0"/>

        <!-- 3. شاشة الفراغ -->
        <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2"
                             IsVisible="{Binding HasNoGroups}"
                             VerticalOptions="Center" 
                             HorizontalOptions="Center" 
                             Spacing="16" 
                             Padding="30">
            
            <Label Text="📂" FontSize="65" HorizontalOptions="Center"/>
            <Label Text="لا توجد مجموعات أو دفعات مضافة" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
            <Label Text="قم بإضافة مجموعة أو دفعة جديدة لكي تتمكن من إدارة الطلاب ولوحة التحكم الأكاديمية." 
                   FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>

            <Button Text="+ إضافة دفعة جديدة" 
                    Command="{Binding OpenAddGroupCommand}"
                    BackgroundColor="{StaticResource AccentYellow}" 
                    TextColor="{StaticResource DarkBackground}"
                    FontAttributes="Bold" CornerRadius="14" HeightRequest="48" Margin="0,10,0,0" Padding="24,0"/>
        </VerticalStackLayout>

    </Grid>

</ContentView>
