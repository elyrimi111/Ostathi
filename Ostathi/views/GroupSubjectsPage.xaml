<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ostathi.GroupSubjectsPage"
             x:Name="RootPage"
             Title="إدارة مواد المجموعات"
             FlowDirection="RightToLeft"
             BackgroundColor="{StaticResource DarkBackground}">

    <Grid RowDefinitions="Auto, Auto, *" Padding="16" RowSpacing="12">

        <!-- Header with Add Button -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">
            <VerticalStackLayout Grid.Column="0" Spacing="3">
                <Label Text="إدارة مواد المجموعات"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>

                <Label Text="استعراض المواد المرتبطة بالمجموعات وتعديلها أو إضافة مادة لمجموعة"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="+ إضافة مادة لمجموعة"
                    Command="{Binding AddGroupSubjectCommand}"
                    BackgroundColor="{StaticResource AccentYellow}"
                    TextColor="{StaticResource DarkBackground}"
                    FontAttributes="Bold"
                    FontSize="12"
                    CornerRadius="10"
                    HeightRequest="40"
                    Padding="12,0"
                    VerticalOptions="Center"/>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource DarkSurface}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0"
                Padding="10,2">
            <SearchBar Placeholder="ابحث باسم المادة أو المجموعة أو الحالة..."
                       Text="{Binding SearchQuery}"
                       TextColor="{StaticResource TextPrimary}"
                       PlaceholderColor="{StaticResource TextSecondary}"
                       BackgroundColor="Transparent"/>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2">

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource AccentYellow}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="8"
                                 Padding="20">
                <Label Text="لا توجد مواد مرتبطة بالمجموعات حالياً"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"/>

                <Label Text="اضغط على (إضافة مادة لمجموعة) لربط مادة بمجموعة دراسية"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         IsVisible="{Binding IsNotBusy}">
                <CollectionView ItemsSource="{Binding FilteredItems}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource DarkSurface}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    Padding="14">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.EditGroupSubjectCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding SubjectName}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource AccentYellow}"/>

                                        <Label Text="{Binding GroupName, StringFormat='المجموعة: {0}'}"
                                               FontSize="13"
                                               TextColor="{StaticResource TextPrimary}"/>

                                        <Label Text="{Binding Status, StringFormat='الحالة: {0}'}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}"/>

                                        <Label Text="{Binding Notes}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               IsVisible="{Binding HasNotes}"/>
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Button Text="تعديل"
                                                FontSize="12"
                                                BackgroundColor="{StaticResource DarkInputBackground}"
                                                TextColor="{StaticResource TextPrimary}"
                                                CornerRadius="8"
                                                HeightRequest="36"
                                                Padding="10,0"
                                                Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.EditGroupSubjectCommand}"
                                                CommandParameter="{Binding .}"/>

                                        <Button Text="🗑"
                                                FontSize="14"
                                                BackgroundColor="{StaticResource DarkInputBackground}"
                                                TextColor="{StaticResource TextPrimary}"
                                                CornerRadius="8"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.DeleteGroupSubjectCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>
