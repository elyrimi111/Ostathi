<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ostathi"
             x:Class="Ostathi.YearWorkPage"
             Title="أعمال السنة"
             BackgroundColor="{StaticResource DarkBackground}"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ========================================== -->
        <!-- 1. Top Header Section -->
        <!-- ========================================== -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="20,16"
              VerticalOptions="Center"
              BackgroundColor="{StaticResource DarkBackground}">

            <!-- Close / Back Button -->
            <Button Grid.Column="0"
                    Text="✕"
                    FontSize="16"
                    TextColor="{StaticResource TextPrimary}"
                    BackgroundColor="{StaticResource DarkSurface}"
                    CornerRadius="18"
                    WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center"
                    Command="{Binding ClosePageCommand}"/>

            <!-- Page Title -->
            <Label Grid.Column="1"
                   Text="إدارة أعمال السنة"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource AccentYellow}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <!-- Spacer -->
            <BoxView Grid.Column="2" WidthRequest="36" BackgroundColor="Transparent"/>
        </Grid>


        <!-- ========================================== -->
        <!-- 2. Main Content Section -->
        <!-- ========================================== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Group Card Integration for Targeted Group Info -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="بيانات المجموعة المستهدفة" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    <local:GroupCard BindingContext="{Binding CurrentGroup}" />
                </VerticalStackLayout>

                <!-- General Batch Statistics Border Card -->
                <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="16">
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding TotalStudentsCount, FallbackValue='35'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="إجمالي الطلاب" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding AverageGrade, FallbackValue='18.5'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource AccentLime}" HorizontalOptions="Center"/>
                            <Label Text="متوسط درجات الدفعة" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Students Year Work Grades Roster Section -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="درجات أعمال السنة للطلاب" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="حفظ الدرجات" Command="{Binding SaveYearWorkCommand}" BackgroundColor="{StaticResource AccentYellow}" TextColor="{StaticResource DarkBackground}" FontSize="11" FontAttributes="Bold" CornerRadius="10" HeightRequest="32" Padding="12,0"/>
                    </Grid>

                    <!-- Student 1 -->
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="14">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="أحمد خالد علي" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="مشاركة فعالة + تسليم الواجبات بانتظام" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="الدرجة:" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Border BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 8" Padding="10,4" StrokeThickness="0">
                                    <Label Text="19 / 20" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AccentLime}" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Student 2 -->
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="14">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="خالد سعيد أحمد" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="مشاركة متوسطة • تأخر في بعض التكاليف" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="الدرجة:" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Border BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 8" Padding="10,4" StrokeThickness="0">
                                    <Label Text="14 / 20" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Student 3 -->
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="14">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="عبدالله محمد صالح" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="تميز في المشروع العملي والمشاركة" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="الدرجة:" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Border BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 8" Padding="10,4" StrokeThickness="0">
                                    <Label Text="20 / 20" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AccentLime}" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ========================================== -->
        <!-- 3. Bottom Action Footer Bar -->
        <!-- ========================================== -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource DarkSurface}"
                StrokeThickness="0"
                Padding="16,12"
                HeightRequest="75">

            <Button Text="حفظ واعتماد درجات أعمال السنة"
                    BackgroundColor="{StaticResource AccentYellow}"
                    TextColor="{StaticResource DarkBackground}"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="48"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    Command="{Binding SaveYearWorkCommand}"/>

        </Border>

    </Grid>

</ContentPage>
