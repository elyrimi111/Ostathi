<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ostathi.CreateHubPage"
             Title="مركز الإضافات السريعة"
             FlowDirection="RightToLeft"
             BackgroundColor="{StaticResource DarkBackground}">

    <Grid RowDefinitions="Auto, *">

        <!-- ========================================== -->
        <!-- 1. الهيدر العلوي -->
        <!-- ========================================== -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="20,16"
              VerticalOptions="Center"
              BackgroundColor="{StaticResource DarkBackground}">

            <!-- زر الرجوع -->
            <Button Grid.Column="0"
                    Text="✕"
                    FontSize="16"
                    TextColor="{StaticResource TextPrimary}"
                    BackgroundColor="{StaticResource DarkSurface}"
                    CornerRadius="18"
                    WidthRequest="36"
                    HeightRequest="36"
                    Command="{Binding ClosePageCommand}"/>

            <!-- العنوان الرئيسي -->
            <Label Grid.Column="1"
                   Text="مركز الإضافات السريعة"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource AccentYellow}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <BoxView Grid.Column="2" WidthRequest="36" BackgroundColor="Transparent"/>
        </Grid>

        <!-- ========================================== -->
        <!-- 2. محتوى الخيارات بالإضافات المختلفة -->
        <!-- ========================================== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <Label Text="ماذا تريد أن تضيف اليوم؟" 
                       FontSize="14" 
                       TextColor="{StaticResource TextSecondary}" 
                       Margin="0,0,0,8"/>

                <!-- 1. إضافة طالب جديد -->
                <Border BackgroundColor="{StaticResource DarkSurface}" 
                        StrokeShape="RoundRectangle 16" 
                        StrokeThickness="0" 
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddStudentCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource DarkBackground}" StrokeThickness="0">
                            <Label Text="👤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalOptions="Center">
                            <Label Text="إضافة طالب جديد" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="تسجيل طالب جديد وضمه للمجموعات" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="❮" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- 2. إضافة مجموعة جديدة -->
                <Border BackgroundColor="{StaticResource DarkSurface}" 
                        StrokeShape="RoundRectangle 16" 
                        StrokeThickness="0" 
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddGroupCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource DarkBackground}" StrokeThickness="0">
                            <Label Text="📚" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalOptions="Center">
                            <Label Text="إنشاء مجموعة جديدة" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="إضافة فئة دراسية أو شعبة جديدة" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="❮" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- 3. إضافة محاضرة / حصة في الجدول -->
                <Border BackgroundColor="{StaticResource DarkSurface}" 
                        StrokeShape="RoundRectangle 16" 
                        StrokeThickness="0" 
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddLectureCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource DarkBackground}" StrokeThickness="0">
                            <Label Text="📅" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalOptions="Center">
                            <Label Text="إضافة موعد محاضرة" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="جدولة حصة جديدة لمجموعة محددة" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="❮" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- 4. إضافة تكليف / واجب جديد -->
                <Border BackgroundColor="{StaticResource DarkSurface}" 
                        StrokeShape="RoundRectangle 16" 
                        StrokeThickness="0" 
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddAssignmentCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource DarkBackground}" StrokeThickness="0">
                            <Label Text="📝" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalOptions="Center">
                            <Label Text="إضافة تكليف / مشروع" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="تعيين واجب جديد وتحديد موعد التسليم" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="❮" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- 5. إرسال إشعار عام للطلاب -->
                <Border BackgroundColor="{StaticResource DarkSurface}" 
                        StrokeShape="RoundRectangle 16" 
                        StrokeThickness="0" 
                        Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendNotificationCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource DarkBackground}" StrokeThickness="0">
                            <Label Text="📢" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalOptions="Center">
                            <Label Text="إرسال تنبيه / إشعار" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="بث رسالة عاجلة لجميع الطلاب أو مجموعة" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="❮" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
