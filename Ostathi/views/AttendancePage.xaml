<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ostathi"
             x:Class="Ostathi.AttendancePage"
             Title="سجل التحضير اليدوي"
             FlowDirection="RightToLeft"
             BackgroundColor="{StaticResource DarkBackground}">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ========================================== -->
        <!-- 1. Top Header Section -->
        <!-- ========================================== -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="20,16"
              VerticalOptions="Center"
              BackgroundColor="{StaticResource DarkBackground}">

            <!-- Close / Back Button -->
            <Button Grid.Column="0"
                    Text="✕"
                    FontSize="16"
                    TextColor="{StaticResource TextPrimary}"
                    BackgroundColor="{StaticResource DarkSurface}"
                    CornerRadius="18"
                    WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center"
                    Command="{Binding ClosePageCommand}"/>

            <!-- Page Title -->
            <Label Grid.Column="1"
                   Text="التحضير اليدوي للمحاضرة"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource AccentYellow}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <!-- Spacer -->
            <BoxView Grid.Column="2" WidthRequest="36" BackgroundColor="Transparent"/>
        </Grid>


        <!-- ========================================== -->
        <!-- 2. Main Page Content -->
        <!-- ========================================== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Group Card Integration for Targeted Group Info -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="المجموعة المستهدفة للتحضير" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    <local:GroupCard BindingContext="{Binding CurrentGroup}" />
                </VerticalStackLayout>

                <!-- Quick Notice Card -->
                <Border BackgroundColor="{StaticResource DarkSurface}" 
                        StrokeShape="RoundRectangle 16" 
                        StrokeThickness="0" 
                        Padding="16">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="💡" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="قم بتحديد حالة الطالب (حاضر / غائب / مستأذن) ثم اضغط على حفظ السجل بالأسفل." 
                               FontSize="12" 
                               TextColor="{StaticResource TextSecondary}" 
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Students Roster List Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="قائمة الطلاب" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />

                    <!-- Dynamic Students List bound to StudentsList -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding StudentsList}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource DarkSurface}" 
                                        StrokeShape="RoundRectangle 16" 
                                        StrokeThickness="0" 
                                        Padding="14">
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        
                                        <!-- Student Full Name and ID -->
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding FullName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                            <Label Text="{Binding PhoneNumber, StringFormat='الرقم الجامعي: {0}'}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        </VerticalStackLayout>
                                        
                                        <!-- Attendance Status Picker (Present, Absent, Excused) -->
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Label Text="الحالة:" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                            <Picker Title="اختر الحالة"
                                                    SelectedItem="{Binding Status}"
                                                    TextColor="{StaticResource AccentYellow}"
                                                    TitleColor="{StaticResource TextSecondary}"
                                                    FontSize="12"
                                                    WidthRequest="110">
                                                <Picker.ItemsSource>
                                                    <x:Array Type="{x:Type local:AttendanceStatus}">
                                                        <local:AttendanceStatus>Present</local:AttendanceStatus>
                                                        <local:AttendanceStatus>Absent</local:AttendanceStatus>
                                                        <local:AttendanceStatus>Excused</local:AttendanceStatus>
                                                    </x:Array>
                                                </Picker.ItemsSource>
                                            </Picker>
                                        </HorizontalStackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>


        <!-- ========================================== -->
        <!-- 3. Bottom Action Footer Bar -->
        <!-- ========================================== -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource DarkSurface}"
                StrokeThickness="0"
                Padding="16,12"
                HeightRequest="75">

            <Button Text="حفظ وتأكيد سجل التحضير"
                    BackgroundColor="{StaticResource AccentYellow}"
                    TextColor="{StaticResource DarkBackground}"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="48"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    Command="{Binding SaveAttendanceCommand}"/>

        </Border>

    </Grid>

</ContentPage>
