<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ostathi"
             x:Class="Ostathi.MidtermExamPage"
             Title="الاختبار النصفي"
             BackgroundColor="{StaticResource DarkBackground}"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ========================================== -->
        <!-- 1. Top Header Section -->
        <!-- ========================================== -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="20,16"
              VerticalOptions="Center"
              BackgroundColor="{StaticResource DarkBackground}">

            <!-- Close / Back Button -->
            <Button Grid.Column="0"
                    Text="✕"
                    FontSize="16"
                    TextColor="{StaticResource TextPrimary}"
                    BackgroundColor="{StaticResource DarkSurface}"
                    CornerRadius="18"
                    WidthRequest="36"
                    HeightRequest="36"
                    VerticalOptions="Center"
                    Command="{Binding ClosePageCommand}"/>

            <!-- Page Title -->
            <Label Grid.Column="1"
                   Text="إدارة الاختبار النصفي"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource AccentYellow}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <!-- Spacer -->
            <BoxView Grid.Column="2" WidthRequest="36" BackgroundColor="Transparent"/>
        </Grid>


        <!-- ========================================== -->
        <!-- 2. Main Content Section -->
        <!-- ========================================== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Group Card Integration for Targeted Group Info -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="بيانات المجموعة المستهدفة" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    <local:GroupCard BindingContext="{Binding CurrentGroup}" />
                </VerticalStackLayout>

                <!-- Stats Card -->
                <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="16">
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                            <Label Text="35" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                            <Label Text="إجمالي الطلاب" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                            <Label Text="من 20" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" HorizontalOptions="Center"/>
                            <Label Text="الدرجة القصوى" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Students Grades List Section -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="قائمة درجات الطلاب" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="حفظ التعديلات" 
                                Command="{Binding SaveExamCommand}"
                                BackgroundColor="{StaticResource AccentYellow}" 
                                TextColor="{StaticResource DarkBackground}" 
                                FontAttributes="Bold" FontSize="11" CornerRadius="10" HeightRequest="32" Padding="12,0"/>
                    </Grid>

                    <!-- Student Item 1 -->
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="16">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="أحمد محمد علي" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="رقم القيد: 2023001" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 10" Padding="12,6" StrokeThickness="0">
                                <Label Text="18 / 20" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AccentLime}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Student Item 2 -->
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="16">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="سارة خالد حسن" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="رقم القيد: 2023002" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 10" Padding="12,6" StrokeThickness="0">
                                <Label Text="19 / 20" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AccentLime}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Student Item 3 -->
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="16">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="عمر عبدالله أحمد" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="رقم القيد: 2023003" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 10" Padding="12,6" StrokeThickness="0">
                                <Label Text="15 / 20" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />
                            </Border>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
