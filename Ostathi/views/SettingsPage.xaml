<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ostathi.SettingsPage"
             Title="الإعدادات"
             BackgroundColor="{StaticResource DarkBackground}"
             FlowDirection="RightToLeft">

    <!-- Main grid layout defining rows for header and scrollable content -->
    <Grid RowDefinitions="Auto, *">

        <!-- ========================================== -->
        <!-- 1. Page Header Section -->
        <!-- ========================================== -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource DarkSurface}" StrokeThickness="0" Padding="20,16" StrokeShape="RoundRectangle 0,0,24,24">
            <VerticalStackLayout Spacing="2">
                <Label Text="الإعدادات" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                <Label Text="تخصيص إعدادات التطبيق والحساب" FontSize="12" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
        </Border>

        <!-- ========================================== -->
        <!-- 2. Settings Content Scrollable Area -->
        <!-- ========================================== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Lecturer Information Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="بيانات المحاضر المسؤول" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />
                    
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="اسم الدكتور / الأستاذ" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            
                            <!-- Lecturer Name Entry Input -->
                            <Entry Text="د. محمد فؤاد أحمد" 
                                   Placeholder="أدخل اسم الدكتور هنا..." 
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   BackgroundColor="{StaticResource DarkBackground}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   HeightRequest="44"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Academic Settings Section (Year, Term, Majors, and Schedule) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="الإعدادات الأكاديمية" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />
                    
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16">
                        <VerticalStackLayout Spacing="16">
                            
                            <!-- Academic Year Picker Selection -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="السنة الدراسية" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="اختر العام الدراسي الحالي" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Picker Grid.Column="1" Title="اختر السنة" 
                                        TextColor="{StaticResource AccentYellow}"
                                        TitleColor="{StaticResource TextSecondary}"
                                        FontSize="14"
                                        WidthRequest="150">
                                    <Picker.Items>
                                        <x:String>2025 - 2026</x:String>
                                        <x:String>2026 - 2027</x:String>
                                        <x:String>2027 - 2028</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Grid>

                            <!-- Academic Semester Picker Selection -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="الترم الدراسي" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="اختر الفصل الدراسي النشط" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Picker Grid.Column="1" Title="اختر الترم" 
                                        TextColor="{StaticResource AccentYellow}"
                                        TitleColor="{StaticResource TextSecondary}"
                                        FontSize="14"
                                        WidthRequest="150">
                                    <Picker.Items>
                                        <x:String>الترم الأول</x:String>
                                        <x:String>الترم الثاني</x:String>
                                        <x:String>الترم الصيفي</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Grid>

                            <!-- Default Academic Major Picker Selection -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="التخصص الأكاديمي الرئيسي" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="اختر التخصص أو القسم الافتراضي" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Picker Grid.Column="1" Title="اختر التخصص" 
                                        TextColor="{StaticResource AccentYellow}"
                                        TitleColor="{StaticResource TextSecondary}"
                                        FontSize="14"
                                        WidthRequest="150">
                                    <Picker.Items>
                                        <x:String>علوم الحاسب وتطوير الويب</x:String>
                                        <x:String>هندسة البرمجيات (.NET)</x:String>
                                        <x:String>قواعد البيانات وتحليل البيانات</x:String>
                                        <x:String>الشبكات وأمن المعلومات</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Grid>

                            <!-- Schedule Management Navigation Button -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="جدول المحاضرات الأسبوعي" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="إدارة وتعديل مواعيد وحصص المجموعات" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="إدارة الجدول 📅" 
                                        Command="{Binding OpenScheduleManagementCommand}"
                                        BackgroundColor="{StaticResource DarkBackground}" 
                                        TextColor="{StaticResource AccentYellow}"
                                        FontSize="12"
                                        CornerRadius="10"
                                        HeightRequest="38"
                                        Padding="14,0" />
                            </Grid>

                            <!-- Majors Management Navigation Button -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="إدارة التخصصات الأكاديمية" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="إضافة، تعديل، وحذف التخصصات وقوائمها" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="إدارة التخصصات 🎓" 
                                        Command="{Binding OpenMajorsPageCommand}"
                                        BackgroundColor="{StaticResource DarkBackground}" 
                                        TextColor="{StaticResource AccentYellow}"
                                        FontSize="12"
                                        CornerRadius="10"
                                        HeightRequest="38"
                                        Padding="14,0" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- App Appearance and Preferences Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="المظهر والتفضيلات" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />
                    
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16">
                        <VerticalStackLayout Spacing="16">
                            
                            <!-- Dark Mode Toggle Switch -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="الثيم الداكن (Dark Mode)" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="مفعل افتراضياً لراحة العين" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="True" OnColor="{StaticResource AccentYellow}" />
                            </Grid>

                            <!-- Notifications Toggle Switch -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="إشعارات التذكير بالحصص" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="تنبيهات بمواعيد المجموعات القادمة" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="True" OnColor="{StaticResource AccentYellow}" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- About App Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="حول النظام" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />
                    
                    <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="إصدار التطبيق" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="1" Text="v1.0.0 (2026)" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="اسم النظام" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="1" Text="Ostathi .NET MAUI" FontSize="14" TextColor="{StaticResource AccentYellow}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Logout Action Button -->
                <Button Text="تسجيل الخروج" 
                        BackgroundColor="{StaticResource AccentCoral}" 
                        TextColor="{StaticResource TextPrimary}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="46"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
