<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ostathi.SettingsPage"
             Title="الإعدادات"
             BackgroundColor="{StaticResource DarkBackground}"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, *">

        <!-- ========================================== -->
        <!-- 1. Header Section (Instagram Style Header) -->
        <!-- ========================================== -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource DarkSurface}" 
                StrokeThickness="0" 
                Padding="20,16">
            <VerticalStackLayout Spacing="2">
                <Label Text="الإعدادات" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource TextPrimary}" />
                <Label Text="إدارة حسابك وتفضيلات النظام" 
                       FontSize="12" 
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
        </Border>

        <!-- ========================================== -->
        <!-- 2. Settings Rows List Area -->
        <!-- ========================================== -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="24">

                <!-- SECTION 1: Academic & Management Settings -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="الإعدادات الأكاديمية" 
                           FontSize="13" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource TextSecondary}" 
                           Margin="8,0" />

                    <Border BackgroundColor="{StaticResource DarkSurface}" 
                            StrokeShape="RoundRectangle 16" 
                            StrokeThickness="0" 
                            Padding="0">
                        <VerticalStackLayout Spacing="0">

                            <!-- Row 1: Academic Details Page (Year, Term, Major, Lecturer) -->
                            <Grid ColumnDefinitions="Auto, *, Auto" 
                                  Padding="16,14" 
                                  BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenAcademicSettingsCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="🎓" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="البيانات الأكاديمية والشخصية" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="السنة، الترم، التخصص، وبيانات المحاضر" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="‹" FontSize="20" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource DarkBackground}" Margin="16,0" />

                            <!-- Row 2: Schedule Management -->
                            <Grid ColumnDefinitions="Auto, *, Auto" 
                                  Padding="16,14" 
                                  BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenScheduleManagementCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="📅" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="جدول المحاضرات الأسبوعي" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="تعديل مواعيد وحصص المجموعات" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="‹" FontSize="20" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource DarkBackground}" Margin="16,0" />

                            <!-- Row 3: Majors Management -->
                            <Grid ColumnDefinitions="Auto, *, Auto" 
                                  Padding="16,14" 
                                  BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenMajorsPageCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="🏛️" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="إدارة التخصصات الأكاديمية" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="إضافة وتعديل قوائم الاقسام والتخصصات" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="‹" FontSize="20" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SECTION 2: App Preferences -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="التفضيلات والمظهر" 
                           FontSize="13" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource TextSecondary}" 
                           Margin="8,0" />

                    <Border BackgroundColor="{StaticResource DarkSurface}" 
                            StrokeShape="RoundRectangle 16" 
                            StrokeThickness="0" 
                            Padding="0">
                        <VerticalStackLayout Spacing="0">

                            <!-- Row 1: Dark Mode Toggle -->
                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,12">
                                <Label Grid.Column="0" Text="🌙" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>
                                <Label Grid.Column="1" Text="الثيم الداكن (Dark Mode)" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                <Switch Grid.Column="2" IsToggled="True" OnColor="{StaticResource AccentYellow}" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource DarkBackground}" Margin="16,0" />

                            <!-- Row 2: Notifications Toggle -->
                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,12">
                                <Label Grid.Column="0" Text="🔔" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>
                                <Label Grid.Column="1" Text="إشعارات التذكير بالحصص" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                                <Switch Grid.Column="2" IsToggled="True" OnColor="{StaticResource AccentYellow}" VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SECTION 3: System Info & About Page -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="الدعم والتعريف" 
                           FontSize="13" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource TextSecondary}" 
                           Margin="8,0" />

                    <Border BackgroundColor="{StaticResource DarkSurface}" 
                            StrokeShape="RoundRectangle 16" 
                            StrokeThickness="0" 
                            Padding="0">
                        <!-- Clickable Row to open About Page -->
                        <Grid ColumnDefinitions="Auto, *, Auto" 
                              Padding="16,14" 
                              BackgroundColor="Transparent">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAboutPageCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="ℹ️" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="حول نظام أستاذي (Ostathi)" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="الإصدار v1.0.0 والمعلومات التقنية" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="‹" FontSize="20" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- SECTION 4: Account Actions (Logout) -->
                <Border BackgroundColor="{StaticResource DarkSurface}" 
                        StrokeShape="RoundRectangle 16" 
                        StrokeThickness="0" 
                        Padding="0" 
                        Margin="0,8,0,20">
                    <Grid ColumnDefinitions="Auto, *" 
                          Padding="16,14" 
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🚪" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="تسجيل الخروج" 
                               FontSize="15" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource AccentCoral}" 
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
