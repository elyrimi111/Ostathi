<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ostathi.ManageSingleGroupSubjectView"
             BackgroundColor="{StaticResource DarkBackground}"
             FlowDirection="RightToLeft"
             Title="إدارة مادة المجموعة">

    <!-- Grid رئيسي يملأ الشاشة بالكامل -->
    <Grid Padding="16" RowDefinitions="Auto, Auto, Auto, *" RowSpacing="12">

        <!-- 1. رأس الصفحة (Header) -->
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="إدارة مادة المجموعة" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
            <Label Text="تفاصيل وإدارة المقرر الدراسي لهذه المجموعة الأكاديمية" Style="{StaticResource CardAccentSubtitleStyle}" FontSize="12"/>
        </VerticalStackLayout>

        <!-- 2. البطاقة العلوية الأساسية -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 22" StrokeThickness="0" Padding="18">
            <VerticalStackLayout Spacing="14">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="{Binding GroupName, StringFormat='المجموعة: {0}'}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding SubjectName, StringFormat='المادة: {0}'}" FontSize="12" TextColor="{StaticResource AccentYellow}" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="{StaticResource DarkBackground}" Opacity="0.6"/>

                <Button Text="📊 تصدير السجل الشامل للمادة" 
                        Command="{Binding ExportCommand}" 
                        BackgroundColor="{StaticResource DarkBackground}" 
                        TextColor="{StaticResource AccentYellow}" 
                        FontSize="12" 
                        FontAttributes="Bold" 
                        CornerRadius="12" 
                        HeightRequest="40" 
                        HorizontalOptions="Fill"/>
            </VerticalStackLayout>
        </Border>

        <!-- 3. عنوان فرعي للخدمات -->
        <Label Grid.Row="2" Text="الخدمات والعمليات السريعة" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="2,4,2,0"/>

        <!-- 4. شبكة المربعات السفلية (6 عناصر موزعة على 3 صفوف) -->
        <Grid Grid.Row="3" 
              ColumnDefinitions="*, *" ColumnSpacing="12" 
              RowDefinitions="*, *, *" RowSpacing="10" 
              VerticalOptions="Fill" HorizontalOptions="Fill">
            
            <!-- سجل الحضور -->
            <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12" VerticalOptions="Fill" HorizontalOptions="Fill">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenAttendanceCommand}"/></Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="📋" FontSize="24" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="سجل الحضور" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="متابعة الغياب والحضور" FontSize="10" TextColor="{StaticResource CardAccentSubtitleStyle}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- التكاليف -->
            <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12" VerticalOptions="Fill" HorizontalOptions="Fill">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenAssignmentsCommand}"/></Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="⏰" FontSize="24" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="التكاليف" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="المهام والواجبات" FontSize="10" TextColor="{StaticResource CardAccentSubtitleStyle}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- التواصل مع الطلاب والمندوب -->
            <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12" VerticalOptions="Fill" HorizontalOptions="Fill">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenStudentCommunicationCommand}"/></Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="💬" FontSize="24" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="التواصل والـمندوب" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="اتصال، واتساب وتعاميم" FontSize="10" TextColor="{StaticResource CardAccentSubtitleStyle}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- المحاضرات -->
            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12" VerticalOptions="Fill" HorizontalOptions="Fill">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenLecturesCommand}"/></Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="🏛️" FontSize="24" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="المحاضرات" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="محتوى وجداول الدروس" FontSize="10" TextColor="{StaticResource CardAccentSubtitleStyle}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- الدرجات -->
            <Border Grid.Row="2" Grid.Column="0" BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12" VerticalOptions="Fill" HorizontalOptions="Fill">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenGradesCommand}"/></Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="🎓" FontSize="24" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="الدرجات" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="النتائج والتقييم النهائي" FontSize="10" TextColor="{StaticResource CardAccentSubtitleStyle}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- إدارة طلاب المجموعة -->
            <Border Grid.Row="2" Grid.Column="1" BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="12" VerticalOptions="Fill" HorizontalOptions="Fill">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenGroupStudentsCommand}"/></Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="👥" FontSize="24" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="إدارة طلاب المجموعة" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="قائمة الطلاب والإدارة" FontSize="10" TextColor="{StaticResource CardAccentSubtitleStyle}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
