<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ostathi.AddUpdateGroup"
             x:Name="AddUpdateGroupPage"
             Title="{Binding PageTitleText}"
             FlowDirection="RightToLeft"
             BackgroundColor="{StaticResource DarkBackground}">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Page header section -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource DarkSurface}"
                StrokeThickness="0"
                Padding="16,14"
                StrokeShape="RoundRectangle 0,0,24,24">

            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="إدارة المجموعات"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" />
                <Label Text="{Binding PageTitleText}"
                       FontSize="11"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
        </Border>

        <!-- Scrollable form content -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="16">

                <!-- Major and AcademicYear side-by-side selection -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">

                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="التخصص"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border BackgroundColor="{StaticResource DarkSurface}"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="45"
                                StrokeThickness="0"
                                Padding="10,0">
                            <Picker ItemsSource="{Binding MajorsList}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedMajor}"
                                    Title="اختر التخصص..."
                                    TitleColor="{StaticResource TextSecondary}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontSize="12"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="السنة الدراسية"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                        <Border BackgroundColor="{StaticResource DarkSurface}"
                                StrokeShape="RoundRectangle 12"
                                HeightRequest="45"
                                StrokeThickness="0"
                                Padding="10,0">
                            <Picker ItemsSource="{Binding AcademicYearsList}"
                                    SelectedItem="{Binding SelectedAcademicYear}"
                                    IsEnabled="{Binding IsAcademicYearEnabled}"
                                    Title="اختر السنة..."
                                    TitleColor="{StaticResource TextSecondary}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontSize="12"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />
                        </Border>
                    </VerticalStackLayout>

                </Grid>

                <!-- GroupNumber input -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="رقم المجموعة"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />
                    <Border BackgroundColor="{StaticResource DarkSurface}"
                            StrokeShape="RoundRectangle 12"
                            HeightRequest="45"
                            StrokeThickness="0"
                            Padding="12,0">
                        <Entry Text="{Binding GroupNumber}"
                               IsEnabled="{Binding IsGroupNumberEnabled}"
                               Placeholder="مثال: 1"
                               Keyboard="Numeric"
                               MaxLength="10"
                               FontSize="13"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center"
                               BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- GroupDescription input -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="الوصف (اختياري)"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />
                    <Border BackgroundColor="{StaticResource DarkSurface}"
                            StrokeShape="RoundRectangle 12"
                            MinimumHeightRequest="80"
                            StrokeThickness="0"
                            Padding="12,8">
                        <Editor Text="{Binding GroupDescription}"
                                Placeholder="اكتب وصفاً مختصراً للمجموعة..."
                                MaxLength="500"
                                FontSize="13"
                                TextColor="{StaticResource TextPrimary}"
                                PlaceholderColor="{StaticResource TextSecondary}"
                                AutoSize="TextChanges"
                                BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- Import students button -->
                <Button Text="استيراد الطلاب"
                        Command="{Binding ImportStudentsCommand}"
                        BackgroundColor="{StaticResource DarkSurface}"
                        TextColor="{StaticResource AccentYellow}"
                        BorderColor="{StaticResource AccentYellow}"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="12"
                        HeightRequest="45"
                        Margin="0,4,0,0" />

                <!-- قائمة الطلاب المستوردين بنفس ثيم بطاقات الطلاب -->
                <Border IsVisible="{Binding HasImportedStudents}"
                        BackgroundColor="{StaticResource DarkSurface}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="0"
                        Padding="14">
                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding StudentsCountText}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding RepresentativeSummaryText}"
                                   FontSize="10"
                                   TextColor="{StaticResource AccentYellow}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ImportedStudents}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource DarkBackground}"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0"
                                            Padding="14,12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.SelectImportedStudentCommand, Source={x:Reference AddUpdateGroupPage}}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Index, StringFormat='{}{0}.'}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource AccentYellow}"
                                                   VerticalOptions="Center" />

                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Label Text="{Binding DisplayName}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}" />
                                                    <Label Text="(مندوب)"
                                                           IsVisible="{Binding IsRepresentative}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource AccentYellow}"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding AcademicId, StringFormat='الرقم: {0}'}"
                                                       FontSize="11"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>

                                            <Button Grid.Column="2"
                                                    Text="⋮"
                                                    Command="{Binding BindingContext.StudentOptionsCommand, Source={x:Reference AddUpdateGroupPage}}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    Padding="0"
                                                    VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom action bar -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource DarkSurface}"
                StrokeThickness="0"
                Padding="16,12">

            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="{Binding SaveButtonText}"
                        Command="{Binding SaveGroupCommand}"
                        BackgroundColor="{StaticResource AccentYellow}"
                        TextColor="{StaticResource DarkBackground}"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="14"
                        HeightRequest="45" />

                <Button Grid.Column="1"
                        Text="إلغاء"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{StaticResource DarkBackground}"
                        TextColor="{StaticResource TextSecondary}"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="14"
                        HeightRequest="45" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>
