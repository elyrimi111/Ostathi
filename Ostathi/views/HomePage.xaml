<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ostathi.HomePage"
             BackgroundColor="{StaticResource DarkBackground}"
             FlowDirection="RightToLeft">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="22">

            <!-- 1. البطاقة الكبيرة الخاصة بالمحاضرة الحالية (فقط) -->
            <Border BackgroundColor="{StaticResource DarkSurface}" 
                    StrokeShape="RoundRectangle 24" 
                    StrokeThickness="0" 
                    Padding="22">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="12">
                    
                    <!-- رأس البطاقة -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="المحاضرة القادمة (العملية الحالية)" FontSize="14" TextColor="{StaticResource AccentYellow}" FontAttributes="Bold" />
                        <Border Grid.Column="1" BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 10" Padding="10,4" StrokeThickness="0">
                            <Label Text="تبدأ قريباً" FontSize="11" TextColor="{StaticResource AccentLime}" FontAttributes="Bold"/>
                        </Border>
                    </Grid>

                    <!-- تفاصيل المحاضرة -->
                    <VerticalStackLayout Grid.Row="1" Spacing="4">
                        <Label Text="{Binding NextLectureTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding NextLectureLocation}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding NextLectureTime}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <!-- المحاضرات المتبقية والتعويضية داخل بطاقة المحاضرة -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,4,0,0">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 12" Padding="10" StrokeThickness="0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="المحاضرات المتبقية" FontSize="10" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding RemainingLecturesCount}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 12" Padding="10" StrokeThickness="0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="المحاضرات التعويضية" FontSize="10" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding MakeupLecturesCount}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource AccentLime}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- زر بدء التحضير -->
                    <Button Grid.Row="3" Text="+ بدء التحضير اليدوي لهذه المحاضرة" 
                            Command="{Binding StartAttendanceCommand}"
                            BackgroundColor="{StaticResource AccentYellow}" 
                            TextColor="{StaticResource DarkBackground}"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="46"
                            Margin="0,6,0,0"/>

                </Grid>
            </Border>


            <!-- ========================================== -->
            <!-- 2. بطاقة منفصلة: ملخص الترم الأكاديمي والوقت المتبقي -->
            <!-- ========================================== -->
            <Border BackgroundColor="{StaticResource DarkSurface}" 
                    StrokeShape="RoundRectangle 24" 
                    StrokeThickness="0" 
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    
                    <Label Text="الملخص الأكاديمي والزمني" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />

                    <!-- السنة الأكاديمية -->
                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="📅 السنة الأكاديمية: " FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                        <Label Grid.Column="1" Text="{Binding AcademicYearText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="End"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource DarkBackground}"/>

                    <!-- الأسابيع المتبقية للترم -->
                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="⏳ المتبقي لنهاية الترم: " FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                        <Label Grid.Column="1" Text="{Binding RemainingTermTime}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" HorizontalOptions="End"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource DarkBackground}"/>

                    <!-- المتبقي للاختبارات -->
                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="📝 المتبقي للاختبارات النهائية: " FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                        <Label Grid.Column="1" Text="{Binding RemainingExamsTime}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource AccentLime}" HorizontalOptions="End"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>


            <!-- 3. قسم التكاليف والواجبات القادمة (أزرار تفاعلية) -->
            <VerticalStackLayout Spacing="14">
                <Label Text="التكاليف والواجبات القادمة" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />

                <!-- زر تفاعلي لتكليف مشروع C# -->
                <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAssignmentDetailCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 12" WidthRequest="40" HeightRequest="40" StrokeThickness="0" VerticalOptions="Center">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z" 
                                  Fill="{StaticResource AccentYellow}" WidthRequest="20" HeightRequest="20" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="مشروع C# - قواعد البيانات" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="مجموعة البرمجة المتقدمة • موعد التسليم: غداً" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 10" Padding="10,6" StrokeThickness="0" VerticalOptions="Center">
                            <Label Text="قيد المتابعة" FontSize="11" TextColor="{StaticResource AccentYellow}" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- زر تفاعلي لتكليف تقرير الحضور -->
                <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAssignmentDetailCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 12" WidthRequest="40" HeightRequest="40" StrokeThickness="0" VerticalOptions="Center">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z" 
                                  Fill="{StaticResource AccentLime}" WidthRequest="20" HeightRequest="20" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="تسليم تقرير الحضور والغياب" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="إدارة النظام • موعد التسليم: خلال 3 أيام" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 10" Padding="10,6" StrokeThickness="0" VerticalOptions="Center">
                            <Label Text="جديد" FontSize="11" TextColor="{StaticResource AccentLime}" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
