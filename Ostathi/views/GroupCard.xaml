<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ostathi.GroupCard"
             FlowDirection="RightToLeft">

    <!-- Group Card Container -->
    <Border BackgroundColor="{StaticResource DarkSurface}" 
            StrokeShape="RoundRectangle 18" 
            StrokeThickness="0" 
            Padding="16"
            Margin="0,0,0,10">
        
        <Grid RowDefinitions="Auto, Auto" RowSpacing="10">

            <!-- 1. اسم المجموعة (Name) -->
            <Label Grid.Row="0"
                   Text="{Binding Name}" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextPrimary}" 
                   VerticalOptions="Center" />

            <!-- 2. المادة والسنة الدراسية -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="10" VerticalOptions="Center">
                
                <!-- اسم المادة الدراسية (SubjectName) -->
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <Label Text="📖" FontSize="14" VerticalOptions="Center"/>
                    <Label Text="{Binding SubjectName}" 
                           FontSize="12" 
                           TextColor="{StaticResource AccentYellow}" 
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- السنة الدراسية (AcademicYear) -->
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                    <Label Text="🎓" FontSize="14" VerticalOptions="Center"/>
                    <Label Text="{Binding AcademicYear, FallbackValue='السنة الدراسية'}" 
                           FontSize="12" 
                           TextColor="{StaticResource TextSecondary}" 
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                
            </Grid>

        </Grid>
    </Border>

</ContentView>
