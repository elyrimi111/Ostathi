<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ostathi"
             x:Class="Ostathi.ScheduleManagementPage"
             Title="إدارة جدول المحاضرات"
             BackgroundColor="{StaticResource DarkBackground}"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, *">

        <!-- 1. الهيدر العلوي لشاشة جدول المحاضرات -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource DarkSurface}" StrokeThickness="0" Padding="20,16" StrokeShape="RoundRectangle 0,0,24,24">
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="جدول المحاضرات الأسبوعي" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Label Text="تنظيم وتحديد أوقات القاعات والمجموعات" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- زر إضافة محاضرة جديدة -->
                <Button Grid.Column="1" Text="+ إضافة محاضرة" 
                        Command="{Binding AddLectureCommand}"
                        BackgroundColor="{StaticResource AccentYellow}" 
                        TextColor="{StaticResource DarkBackground}"
                        FontAttributes="Bold" FontSize="12" CornerRadius="14" HeightRequest="40" Padding="14,0" />
            </Grid>
        </Border>

        <!-- 2. محتوى المحاضرات والأيام -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- شريط أياّم الأسبوع للفلترة والتنقل السريع -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        
                        <!-- السبت -->
                        <Border StrokeShape="RoundRectangle 14" Padding="16,8" StrokeThickness="0" BackgroundColor="{StaticResource DarkSurface}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedDay}" Value="السبت">
                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentYellow}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="السبت" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding SelectedDay}" Value="السبت">
                                        <Setter Property="TextColor" Value="{StaticResource DarkBackground}" />
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDayCommand}" CommandParameter="السبت"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                        <!-- الأحد -->
                        <Border StrokeShape="RoundRectangle 14" Padding="16,8" StrokeThickness="0" BackgroundColor="{StaticResource DarkSurface}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedDay}" Value="الأحد">
                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentYellow}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="الأحد" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding SelectedDay}" Value="الأحد">
                                        <Setter Property="TextColor" Value="{StaticResource DarkBackground}" />
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDayCommand}" CommandParameter="الأحد"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                        <!-- الإثنين -->
                        <Border StrokeShape="RoundRectangle 14" Padding="16,8" StrokeThickness="0" BackgroundColor="{StaticResource DarkSurface}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedDay}" Value="الإثنين">
                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentYellow}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="الإثنين" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding SelectedDay}" Value="الإثنين">
                                        <Setter Property="TextColor" Value="{StaticResource DarkBackground}" />
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDayCommand}" CommandParameter="الإثنين"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                        <!-- الثلاثاء -->
                        <Border StrokeShape="RoundRectangle 14" Padding="16,8" StrokeThickness="0" BackgroundColor="{StaticResource DarkSurface}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedDay}" Value="الثلاثاء">
                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentYellow}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="الثلاثاء" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding SelectedDay}" Value="الثلاثاء">
                                        <Setter Property="TextColor" Value="{StaticResource DarkBackground}" />
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDayCommand}" CommandParameter="الثلاثاء"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                        <!-- الأربعاء -->
                        <Border StrokeShape="RoundRectangle 14" Padding="16,8" StrokeThickness="0" BackgroundColor="{StaticResource DarkSurface}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedDay}" Value="الأربعاء">
                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentYellow}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="الأربعاء" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding SelectedDay}" Value="الأربعاء">
                                        <Setter Property="TextColor" Value="{StaticResource DarkBackground}" />
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDayCommand}" CommandParameter="الأربعاء"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                        <!-- الخميس -->
                        <Border StrokeShape="RoundRectangle 14" Padding="16,8" StrokeThickness="0" BackgroundColor="{StaticResource DarkSurface}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedDay}" Value="الخميس">
                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentYellow}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="الخميس" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding SelectedDay}" Value="الخميس">
                                        <Setter Property="TextColor" Value="{StaticResource DarkBackground}" />
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectDayCommand}" CommandParameter="الخميس"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                    </HorizontalStackLayout>
                </ScrollView>

                <!-- بطاقة ملخص محاضرات اليوم المحدد -->
                <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="16">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding SelectedDay, StringFormat='محاضرات اليوم ({0})'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="المحاضرات المجدولة لهذا اليوم" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource DarkBackground}" StrokeShape="RoundRectangle 10" Padding="10,6" StrokeThickness="0">
                            <Label Text="{Binding LecturesList.Count, StringFormat='{}{0} حصص'}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- قائمة المحاضرات المجدولة ديناميكياً من قاعدة البيانات -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="قائمة المحاضرات" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />

                    <!-- استخدام BindableLayout لعرض كروت المحاضرات بناءً على الـ ViewModel -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LecturesList}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Padding="16">
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <!-- تفاصيل المحاضرة -->
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Major}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                            <HorizontalStackLayout Spacing="12">
                                                <Label Text="{Binding AcademicYear}" FontSize="11" TextColor="{StaticResource AccentLime}" FontAttributes="Bold" />
                                                <Label Text="{Binding HallName, StringFormat='📍 القاعة: {0}'}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                                <Label Text="{Binding Group, StringFormat='مجموعة: {0}'}" FontSize="11" TextColor="{StaticResource AccentYellow}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- أزرار الإجراءات (تعديل وحذف) -->
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                            <Button Text="تعديل" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:ScheduleManagementViewModel}}, Path=EditLectureCommand}" 
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource DarkBackground}" 
                                                    TextColor="{StaticResource TextPrimary}" 
                                                    FontSize="11" CornerRadius="10" HeightRequest="34" Padding="10,0" />
                                            
                                            <Button Text="حذف" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:ScheduleManagementViewModel}}, Path=DeleteLectureCommand}" 
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource DarkSurface}" 
                                                    TextColor="#FF5252" 
                                                    FontSize="11" CornerRadius="10" HeightRequest="34" Padding="10,0" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
