<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ostathi.ReportsPage"
             BackgroundColor="{StaticResource DarkBackground}"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto, *">

        <!-- 1. هيدر الصفحة -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource DarkSurface}" StrokeThickness="0" Padding="20,16" StrokeShape="RoundRectangle 0,0,24,24">
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="التقارير والإحصائيات" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    <Label Text="تقارير الحضور، الأداء، والمالية" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- زر تصدير التقرير -->
                <Button Grid.Column="1" Text="📥 تصدير PDF" 
                        BackgroundColor="{StaticResource AccentYellow}" 
                        TextColor="{StaticResource DarkBackground}"
                        FontAttributes="Bold"
                        FontSize="12"
                        CornerRadius="14"
                        HeightRequest="40"
                        Padding="14,0" />
            </Grid>
        </Border>

        <!-- 2. محتوى التقارير -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- بطاقة ملخص الحضور والغياب -->
                <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="معدل الحضور العام هذا الأسبوع" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Column="1" Text="92%" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentLime}" />
                        </Grid>
                        <ProgressBar Progress="0.92" ProgressColor="{StaticResource AccentLime}" BackgroundColor="{StaticResource DarkBackground}" HeightRequest="6" />
                        <Grid ColumnDefinitions="*, *, *" Margin="0,4,0,0">
                            <Label Grid.Column="0" Text="🟢 الحضور: 115" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1" Text="🔴 الغياب: 10" FontSize="11" TextColor="{StaticResource AccentCoral}" />
                            <Label Grid.Column="2" Text="🟡 المتأخرون: 3" FontSize="11" TextColor="{StaticResource AccentYellow}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- بطاقة التقارير المالية أو الأرباح -->
                <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="الملخص المالي لشهر أكتوبر" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="إجمالي الاشتراكات المحصلة" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1" Text="450,000 ر.ي" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="المبالغ المتبقية (ذمم)" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1" Text="45,000 ر.ي" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource AccentCoral}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- بطاقة تقارير المجموعات -->
                <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="نشاط المجموعات التعليمية" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="مجموعة البرمجة المتقدمة (C#)" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1" Text="8 محاضرات مكتملة" FontSize="13" TextColor="{StaticResource AccentYellow}" />
                        </Grid>
                        
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="مجموعة قواعد البيانات" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1" Text="5 محاضرات مكتملة" FontSize="13" TextColor="{StaticResource AccentYellow}" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="مجموعة .NET MAUI" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Column="1" Text="12 محاضرة مكتملة" FontSize="13" TextColor="{StaticResource AccentYellow}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentView>
