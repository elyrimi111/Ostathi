<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ostathi"
             x:Class="Ostathi.StudentDetailsPage"
             Title="ملف الطالب"
             BackgroundColor="{StaticResource DarkBackground}"
             FlowDirection="RightToLeft">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- ========================================== -->
            <!-- 1. بطاقة البيانات الأساسية للطالب -->
            <!-- ========================================== -->
            <Border BackgroundColor="{StaticResource DarkSurface}" 
                    StrokeShape="RoundRectangle 20" 
                    StrokeThickness="0" 
                    Padding="16">
                
                <VerticalStackLayout Spacing="14">
                    
                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                        <!-- صورة رمزية -->
                        <Frame Grid.Column="0" BackgroundColor="#1E2A38" 
                               HeightRequest="60" WidthRequest="60" 
                               CornerRadius="30" HasShadow="False" Padding="0">
                            <Label Text="👤" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>

                        <!-- الاسم والرقم الأكاديمي -->
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding FullName, FallbackValue='اسم الطالب'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding AcademicId, StringFormat='الرقم الأكاديمي: {0}'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#2D3748" Margin="0,2"/>

                    <!-- التفاصيل الأكاديمية -->
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" RowSpacing="10" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="رقم الهاتف" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding PhoneNumber, FallbackValue='غير متوفر'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                            <Label Text="المجموعة الدراسية" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding GroupName, FallbackValue='المجموعة العامة'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                            <Label Text="المستوى الدراسي" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding AcademicLevel, FallbackValue='المستوى الأول'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                            <Label Text="التخصص الأكاديمي" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                            <Label Text="{Binding MajorName, FallbackValue='عام'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- ========================================== -->
            <!-- 2. قائمة المواد الدراسية التفاعلية -->
            <!-- ========================================== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="المواد الدراسية (اضغط على المادة لإدارة درجاتها):" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />
                
                <CollectionView ItemsSource="{Binding StudentSubjectsList}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 14" Padding="14" Margin="0,0,0,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:StudentDetailsPageViewModel}}, Path=SelectSubjectCommand}" 
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding SubjectName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                        <Label Text="{Binding TeacherOrDetails, FallbackValue='اضغط هنا لإدخال وتعديل الدرجات'}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    
                                    <Border Grid.Column="1" BackgroundColor="#1E2A38" StrokeShape="RoundRectangle 8" Padding="8,4">
                                        <Label Text="{Binding Grade, StringFormat='المعدل: {0}'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" VerticalOptions="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="لا توجد مواد دراسية مسجلة لهذا الطالب." FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" Padding="20"/>
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>

            <!-- ========================================== -->
            <!-- 3. قسم ملاحظات وسلوكيات الطالب -->
            <!-- ========================================== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="ملاحظات وسلوكيات الطالب:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentYellow}" />

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <Border Grid.Column="0" BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="10,2">
                        <Entry Text="{Binding NewNoteText, Mode=TwoWay}"
                               Placeholder="اكتب ملاحظة جديدة عن الطالب هنا..."
                               FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextSecondary}"
                               BackgroundColor="Transparent"
                               HeightRequest="40"/>
                    </Border>
                    
                    <Button Grid.Column="1"
                            Text="إضافة"
                            Command="{Binding AddNoteCommand}"
                            BackgroundColor="{StaticResource AccentYellow}"
                            TextColor="{StaticResource DarkBackground}"
                            FontAttributes="Bold"
                            FontSize="12"
                            CornerRadius="12"
                            HeightRequest="40"
                            WidthRequest="75"/>
                </Grid>

                <CollectionView ItemsSource="{Binding StudentNotesList}" HeightRequest="140">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource DarkSurface}" StrokeShape="RoundRectangle 10" Padding="10" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding NoteContent}" FontSize="12" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding DateString}" FontSize="10" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="لا توجد ملاحظات مسجلة لهذا الطالب حتى الآن." FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" Padding="10"/>
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>

            <!-- ========================================== -->
            <!-- 4. أزرار التحكم -->
            <!-- ========================================== -->
            <VerticalStackLayout Spacing="10" Margin="0,5,0,10">
                <Button Text="تعديل بيانات الطالب الأساسية"
                        BackgroundColor="{StaticResource AccentYellow}"
                        TextColor="{StaticResource DarkBackground}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="46"
                        Command="{Binding EditStudentCommand}"/>

                <Button Text="رجوع للخلف"
                        BackgroundColor="{StaticResource DarkSurface}"
                        TextColor="{StaticResource TextSecondary}"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="46"
                        Command="{Binding ClosePageCommand}"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
