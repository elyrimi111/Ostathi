<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ثيم الألوان الداكن (مستوحى من تصميم واجهة التطبيق الداكن في الصورة المرجعية) -->

    <!-- الألوان المخصصة الأساسية -->
    <Color x:Key="DarkBackground">#121C24</Color>      <!-- خلفية الصفحة العامة (أزرق داكن عميق جداً) -->
    <Color x:Key="DarkSurface">#1B2A35</Color>         <!-- خلفية الهيدر، البطاقات، وشريط التنقل (أزرق فحمي دافئ) -->
    <Color x:Key="DarkInputBackground">#243847</Color> <!-- خلفية الحقول وحقول البحث -->
    
    <!-- الألوان المميزة (Accents) - مستوحى من درجات التيل/الأزرق المائل للأخضر البترولي -->
    <Color x:Key="AccentYellow">#4A8B95</Color>        <!-- اللون الرئيسي للأزرار والنشاط (تيل هادئ وفخم) -->
    <Color x:Key="AccentLime">#34D399</Color>          <!-- الأخضر للحالة أو الإنجاز -->
    <Color x:Key="AccentCoral">#F87171</Color>         <!-- الأحمر للتنبيهات والعمليات السالبة -->

    <!-- النصوص -->
    <Color x:Key="TextPrimary">#F3F4F6</Color>         <!-- النصوص البيضاء/الفاتحة الأساسية -->
    <Color x:Key="TextSecondary">#9CA3AF</Color>       <!-- النصوص والأيقونات الثانوية الرمادية الفاتحة -->

    <Color x:Key="GlassSurface">#261B2A35</Color>      <!-- تأثير الزجاج الناعم الداكن -->


    <!-- تحديث مفاتيح MAUI الافتراضية لتتوافق مع الثيم الجديد -->
    <Color x:Key="Primary">#4A8B95</Color>
    <Color x:Key="PrimaryDark">#3B6F77</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#1B2A35</Color>
    <Color x:Key="SecondaryDarkText">#9CA3AF</Color>
    <Color x:Key="Tertiary">#34D399</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#121C24</Color>
    <Color x:Key="Magenta">#F87171</Color>
    <Color x:Key="MidnightBlue">#4A8B95</Color>
    <Color x:Key="OffBlack">#E5E7EB</Color>
    
    <!-- اللون الشفاف المضاف -->
    <Color x:Key="Transparent">Transparent</Color>

    <!-- درجات الرمادي المتوافقة مع الثيم الداكن -->
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#374151</Color>
    <Color x:Key="Gray900">#1B2A35</Color>
    <Color x:Key="Gray950">#121C24</Color>


    <!-- الفرش (Brushes) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource Transparent}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

</ResourceDictionary>
